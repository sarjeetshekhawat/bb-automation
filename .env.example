# Streamlit Server Configuration (Optional)
# Copy this file to .env if you wish to override Streamlit defaults locally.

# Port on which Streamlit runs (default: 8501)
STREAMLIT_SERVER_PORT=8501

# Address to bind to (default: localhost / 0.0.0.0)
STREAMLIT_SERVER_ADDRESS=localhost

# Run in headless mode (true for servers/containers, false for local desktop)
STREAMLIT_SERVER_HEADLESS=false

# Max upload size in megabytes (matches .streamlit/config.toml)
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=3000

# Usage statistics collection (matches .streamlit/config.toml)
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
